{
  "installCommand": "npm install --omit=dev --include-workspace-root --workspace=frontend && npm install --workspace=frontend --include=dev",
  "buildCommand": "npm run build -w frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
